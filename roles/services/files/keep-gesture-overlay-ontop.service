[Unit]
Description=Keep GestureOverlay above Screenflex kiosk
After=gesture-overlay.service screenflex-kiosk.service
Wants=gesture-overlay.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=kiosk
Environment=DISPLAY=:0
ExecStart=/usr/local/bin/keep-overlay-ontop.sh

[Install]
WantedBy=multi-user.target
