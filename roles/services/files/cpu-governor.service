[Unit]
Description=Set CPU governor to ondemand
DefaultDependencies=no
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'modprobe cpufreq_ondemand 2>/dev/null; for i in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo ondemand > "$i"; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
