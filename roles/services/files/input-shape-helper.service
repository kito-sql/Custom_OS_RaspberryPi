[Unit]
Description=Gesture Overlay Input Shape Helper
After=gesture-overlay.service
Wants=gesture-overlay.service

[Service]
Type=oneshot
User=kiosk
WorkingDirectory=/home
Environment=DISPLAY=:0
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /tmp/.X11-unix/X0 ] && break; sleep 1; done'
ExecStart=/usr/bin/python3 /home/input_shape_helper.py
Restart=no

[Install]
WantedBy=multi-user.target
