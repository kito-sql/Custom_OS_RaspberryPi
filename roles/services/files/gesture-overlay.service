[Unit]
Description=Gesture Overlay - PyQt5 GUI Hand Skeleton
After=screenflex-kiosk.service gesture-engine.service
Wants=gesture-engine.service
Requires=screenflex-kiosk.service

[Service]
CPUAffinity=0,1
Type=simple
User=kiosk
WorkingDirectory=/home
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/tmp/screenflex-runtime
Environment=QT_QPA_PLATFORM=xcb
Environment=XAUTHORITY=/home/kiosk/.Xauthority
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /tmp/.X11-unix/X0 ] && break; sleep 1; done'
ExecStart=/usr/bin/python3 /home/overlay.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
